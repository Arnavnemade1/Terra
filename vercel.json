{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "functions": {
    "api/proxy.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/connector/maps/imagery/:z(\\d{1,2})/:y(\\d{1,7})/:x(\\d{1,7})",
      "destination": "https://services.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/:z/:y/:x",
      "missing": [
        {
          "type": "query",
          "key": "f"
        },
        {
          "type": "query",
          "key": "callback"
        },
        {
          "type": "query",
          "key": "format"
        }
      ]
    },
    {
      "source": "/api/connector/maps/labels/:z(\\d{1,2})/:y(\\d{1,7})/:x(\\d{1,7})",
      "destination": "https://services.arcgisonline.com/ArcGIS/rest/services/Reference/World_Boundaries_and_Places/MapServer/tile/:z/:y/:x",
      "missing": [
        {
          "type": "query",
          "key": "f"
        },
        {
          "type": "query",
          "key": "callback"
        },
        {
          "type": "query",
          "key": "format"
        }
      ]
    },
    {
      "source": "/api/connector/maps/topo/:z(\\d{1,2})/:y(\\d{1,7})/:x(\\d{1,7})",
      "destination": "https://services.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/:z/:y/:x",
      "missing": [
        {
          "type": "query",
          "key": "f"
        },
        {
          "type": "query",
          "key": "callback"
        },
        {
          "type": "query",
          "key": "format"
        }
      ]
    },
    {
      "source": "/api/connector/maps/topographic/:z(\\d{1,2})/:y(\\d{1,7})/:x(\\d{1,7})",
      "destination": "https://services.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/:z/:y/:x",
      "missing": [
        {
          "type": "query",
          "key": "f"
        },
        {
          "type": "query",
          "key": "callback"
        },
        {
          "type": "query",
          "key": "format"
        }
      ]
    },
    {
      "source": "/api/connector/maps/light/:z(\\d{1,2})/:y(\\d{1,7})/:x(\\d{1,7})",
      "destination": "https://services.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Base/MapServer/tile/:z/:y/:x",
      "missing": [
        {
          "type": "query",
          "key": "f"
        },
        {
          "type": "query",
          "key": "callback"
        },
        {
          "type": "query",
          "key": "format"
        }
      ]
    },
    {
      "source": "/api/connector/maps/relief-dark/:z(\\d{1,2})/:y(\\d{1,7})/:x(\\d{1,7})",
      "destination": "https://services.arcgisonline.com/ArcGIS/rest/services/Elevation/World_Hillshade_Dark/MapServer/tile/:z/:y/:x",
      "missing": [
        {
          "type": "query",
          "key": "f"
        },
        {
          "type": "query",
          "key": "callback"
        },
        {
          "type": "query",
          "key": "format"
        }
      ]
    },
    {
      "source": "/api/connector/maps/dark/:z(\\d{1,2})/:y(\\d{1,7})/:x(\\d{1,7})",
      "destination": "https://services.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/:z/:y/:x",
      "missing": [
        {
          "type": "query",
          "key": "f"
        },
        {
          "type": "query",
          "key": "callback"
        },
        {
          "type": "query",
          "key": "format"
        }
      ]
    },
    {
      "source": "/api/connector/maps/dark-labels/:z(\\d{1,2})/:y(\\d{1,7})/:x(\\d{1,7})",
      "destination": "https://services.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Reference/MapServer/tile/:z/:y/:x",
      "missing": [
        {
          "type": "query",
          "key": "f"
        },
        {
          "type": "query",
          "key": "callback"
        },
        {
          "type": "query",
          "key": "format"
        }
      ]
    },
    {
      "source": "/api/connector/maps/terrain-base/:z(\\d{1,2})/:y(\\d{1,7})/:x(\\d{1,7})",
      "destination": "https://services.arcgisonline.com/ArcGIS/rest/services/World_Terrain_Base/MapServer/tile/:z/:y/:x",
      "missing": [
        {
          "type": "query",
          "key": "f"
        },
        {
          "type": "query",
          "key": "callback"
        },
        {
          "type": "query",
          "key": "format"
        }
      ]
    },
    {
      "source": "/api/connector/maps/hillshade/:z(\\d{1,2})/:y(\\d{1,7})/:x(\\d{1,7})",
      "destination": "https://services.arcgisonline.com/ArcGIS/rest/services/Elevation/World_Hillshade/MapServer/tile/:z/:y/:x",
      "missing": [
        {
          "type": "query",
          "key": "f"
        },
        {
          "type": "query",
          "key": "callback"
        },
        {
          "type": "query",
          "key": "format"
        }
      ]
    },
    {
      "source": "/api/connector/maps/transport/:z(\\d{1,2})/:y(\\d{1,7})/:x(\\d{1,7})",
      "destination": "https://services.arcgisonline.com/ArcGIS/rest/services/Reference/World_Transportation/MapServer/tile/:z/:y/:x",
      "missing": [
        {
          "type": "query",
          "key": "f"
        },
        {
          "type": "query",
          "key": "callback"
        },
        {
          "type": "query",
          "key": "format"
        }
      ]
    },
    {
      "source": "/api/connector/gibs/BlueMarble_ShadedRelief_Bathymetry/default/GoogleMapsCompatible_Level8/:z(\\d)/:y(\\d{1,3})/:x(\\d{1,3}).jpg",
      "destination": "https://gibs.earthdata.nasa.gov/wmts/epsg3857/best/BlueMarble_ShadedRelief_Bathymetry/default/GoogleMapsCompatible_Level8/:z/:y/:x.jpg",
      "missing": [
        {
          "type": "query",
          "key": "f"
        },
        {
          "type": "query",
          "key": "callback"
        },
        {
          "type": "query",
          "key": "format"
        }
      ]
    },
    {
      "source": "/api/connector/gibs/VIIRS_Black_Marble/default/2016-01-01/GoogleMapsCompatible_Level8/:z(\\d)/:y(\\d{1,3})/:x(\\d{1,3}).png",
      "destination": "https://gibs.earthdata.nasa.gov/wmts/epsg3857/best/VIIRS_Black_Marble/default/2016-01-01/GoogleMapsCompatible_Level8/:z/:y/:x.png",
      "missing": [
        {
          "type": "query",
          "key": "f"
        },
        {
          "type": "query",
          "key": "callback"
        },
        {
          "type": "query",
          "key": "format"
        }
      ]
    },
    {
      "source": "/api/connector/terrain/tile/:z(\\d{1,2})/:y(\\d{1,7})/:x(\\d{1,7})",
      "destination": "https://elevation3d.arcgis.com/arcgis/rest/services/WorldElevation3D/Terrain3D/ImageServer/tile/:z/:y/:x",
      "missing": [
        {
          "type": "query",
          "key": "f"
        },
        {
          "type": "query",
          "key": "callback"
        },
        {
          "type": "query",
          "key": "format"
        }
      ]
    },
    {
      "source": "/api/:__terra_route*/",
      "destination": "/api/proxy"
    },
    {
      "source": "/api/:__terra_route*",
      "destination": "/api/proxy"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/api/connector/(maps|gibs|terrain)/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Content-Security-Policy",
          "value": "sandbox; default-src 'none'"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}

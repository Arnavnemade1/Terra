{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "functions": {
    "api/[...path].js": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/app", "destination": "/app.html" }
  ]
}

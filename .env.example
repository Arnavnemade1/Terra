# Optional provider credentials. All keys stay on the server: Vite only exposes TERRA_PUBLIC_* to the browser.
VITE_CESIUM_ION_TOKEN=
# Google Maps Platform key with the Map Tiles API enabled (Photorealistic 3D Tiles). Read server-side only and
# sent upstream as a header by backend/terra/google_tiles.py. VITE_GOOGLE_MAPS_KEY is still read as a fallback.
GOOGLE_MAPS_TILES_KEY=
# Earthdata bearer token for NASA protected data; obtain via Earthdata Login.
EARTHDATA_TOKEN=
# Language model for planning, written answers and follow-ups (server-side only).
OPENAI_API_KEY=
# Optional: override the model (default gpt-6-luna).
TERRA_LLM_MODEL=
